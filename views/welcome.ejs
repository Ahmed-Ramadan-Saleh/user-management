<!DOCTYPE html>
<html lang="en">
  <head>
    <script src="./js/color-modes.js"></script>
    <link
      rel="stylesheet"
      href="./bootstrap-icons-1.10.5/font/bootstrap-icons.min.css"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta
      name="author"
      content="Mark Otto, Jacob Thornton, and Bootstrap contributors"
    />
    <meta name="generator" content="Hugo 0.112.5" />
    <title>UM System - Home</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="./css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="./css/dark-light.css" />
    <link href="./css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="./css/myStyle.css" />

    <style>
      :root {
        --brand-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --btn-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      }

      /* 1. Base Structure & Fonts */
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #f1f5f9;
        /* Removed old heavy shadows for a flat, modern look */
        text-shadow: none;
        box-shadow: none;
        min-height: 100vh;
      }

      /* 2. Container Layout */
      .cover-container {
        max-width: 50em; /* Slightly wider for professional balance */
      }

      /* 3. Hero Section Styling */
      h1 {
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
        font-size: 3rem;
      }

      @media (min-width: 768px) {
        h1 {
          font-size: 3.8rem;
        }
      }

      .brand-highlight {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .lead {
        color: #94a3b8; /* Muted slate color for better readability */
        font-weight: 400;
        font-size: 1.15rem;
        line-height: 1.7;
      }

      /* 4. Button Styling */
      
      /* Primary Button (Dashboard) */
      .btn-primary-custom {
        background: var(--btn-gradient);
        border: none;
        color: white;
        padding: 0.85rem 2rem;
        font-weight: 600;
        border-radius: 50px; /* Pill shape */
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
      }

      .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(79, 70, 229, 0.45);
        color: white;
        filter: brightness(1.1);
      }

      /* Secondary Button (Contact) */
      .btn-secondary-custom {
        background: transparent;
        border: 2px solid #334155;
        color: #cbd5e1;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s ease;
      }

      .btn-secondary-custom:hover {
        border-color: #94a3b8;
        color: white;
        background: rgba(255, 255, 255, 0.05);
      }

      /* 5. Footer */
      footer {
        opacity: 0.6;
        font-size: 0.9rem;
        transition: opacity 0.3s;
      }
      footer:hover {
        opacity: 1;
      }
    </style>
  </head>
  <body class="d-flex h-100 text-center">
 
    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
      <%- include('./auth/header.ejs', {currentPage: "welcome"}) %>
 
      <main class="px-3 my-auto">
        <h1 class="mb-4">Welcome to 
          <span class="brand-highlight">UM system</span> 👋
        </h1>
        <p class="lead mt-3 mb-5 mx-auto" style="max-width: 700px;">
          Helping you store and organize the data created and collected
          by your organization. Our goal is to ensure the 
          data in corporate systems is accurate, available, and accessible.
        </p>
        <p class="lead d-flex flex-column flex-sm-row justify-content-center gap-3">
          <a href="/home" class="btn btn-primary-custom btn-lg">
            Go to Dashboard
          </a>

          <a href="#" class="btn btn-secondary-custom btn-lg">
            Contact Sales
          </a>
        </p>
      </main>

      <footer class="mt-auto py-4 text-white-50">
        <p>Designed and developed by Ahmed Ramadan © 2024</p>
      </footer>
    </div>
    <script src="./js/bootstrap.bundle.min.js"></script>
  </body>
</html>