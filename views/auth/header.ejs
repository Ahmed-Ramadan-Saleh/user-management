<!-- 
  Add this <style> block to your main layout <head> 
  or keep it here if this partial is loaded with styles.
-->
<style>
  /* 1. Logo Styling */
  .brand-logo {
    font-size: 1.75rem;
    font-weight: 700;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.2s;
  }
  .brand-logo:hover {
    opacity: 0.8;
  }

  /* 2. Nav Button Styles */
  .nav-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  /* Primary Action (Active / Signup) */
  .nav-btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 15px rgba(79, 70, 229, 0.2);
  }
  .nav-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3);
    color: white;
  }

  /* Secondary Action (Inactive / Login) */
  .nav-btn-secondary {
    background: transparent;
    color: #cbd5e1;
    border: 1px solid #334155;
  }
  .nav-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #4f46e5;
    color: white;
  }

  /* 3. Logged In State */
  .user-welcome {
    color: #94a3b8;
    font-size: 0.9rem;
  }
  .user-email {
    color: #f1f5f9;
    font-weight: 500;
  }
  
  .btn-logout {
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 500;
    font-size: 0.85rem;
    color: #94a3b8;
    border: 1px solid #334155;
    background: transparent;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-logout:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
    color: #ef4444;
  }
</style>

<header class="mb-auto pt-3">
  <div class="d-flex justify-content-between align-items-center">
    
    <!-- Logo -->
    <h3 class="mb-0">
      <a href="/" class="brand-logo">UM System</a>
    </h3>
  
    <% if (user) { %>
      <!-- Logged In State -->
      <div class="d-flex align-items-center gap-3">
        <span class="user-welcome d-none d-md-block">
          Welcome, <span class="user-email"><%= user.email %></span>
        </span>
        <a class="btn-logout" href="/signout">
          <i class="bi bi-box-arrow-right me-1"></i> Sign out
        </a>
      </div>

    <% } else { %>
  
      <!-- Logged Out State -->
      <nav class="d-flex gap-2">
        <!-- Logic: If on login page, highlight Login. Otherwise it's secondary. -->
        <a 
          class="nav-btn <%= currentPage == "login" ? "nav-btn-primary" : "nav-btn-secondary" %>" 
          href="/login"
        >
          Log in
        </a>

        <!-- Logic: If on signup page, highlight Signup. Otherwise it's secondary. -->
        <a 
          class="nav-btn <%= currentPage == "signup" ? "nav-btn-primary" : "nav-btn-secondary" %>" 
          href="/signup"
        >
          Sign up
        </a>
      </nav>

    <% } %>

  </div>
</header>